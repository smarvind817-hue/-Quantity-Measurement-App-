public class QuantityMeasurementApp {

    // ----------- ENUM FOR UNITS -----------
    enum LengthUnit {
        FEET(1.0),          // base unit
        INCH(1.0 / 12.0);   // 1 inch = 1/12 feet

        private final double toFeetFactor;

        LengthUnit(double toFeetFactor) {
            this.toFeetFactor = toFeetFactor;
        }

        public double toFeet(double value) {
            return value * toFeetFactor;
        }
    }

    // ----------- GENERIC QUANTITY CLASS -----------
    static class QuantityLength {
        private final double value;
        private final LengthUnit unit;

        public QuantityLength(double value, LengthUnit unit) {
            if (unit == null) {
                throw new IllegalArgumentException("Unit cannot be null");
            }
            this.value = value;
            this.unit = unit;
        }

        // Convert to base unit (feet)
        private double toFeet() {
            return unit.toFeet(value);
        }

        // Override equals()
        @Override
        public boolean equals(Object obj) {
            if (this == obj) return true;

            if (obj == null || getClass() != obj.getClass()) return false;

            QuantityLength other = (QuantityLength) obj;

            return Double.compare(this.toFeet(), other.toFeet()) == 0;
        }
    }

    // ----------- TEST METHODS -----------
    public static void runTests() {

        // Same unit equality
        System.out.println("Feet = Feet (same): " +
                new QuantityLength(1.0, LengthUnit.FEET)
                        .equals(new QuantityLength(1.0, LengthUnit.FEET))); // true

        System.out.println("Inch = Inch (same): " +
                new QuantityLength(1.0, LengthUnit.INCH)
                        .equals(new QuantityLength(1.0, LengthUnit.INCH))); // true

        // Cross-unit equality
        System.out.println("1 ft = 12 inch: " +
                new QuantityLength(1.0, LengthUnit.FEET)
                        .equals(new QuantityLength(12.0, LengthUnit.INCH))); // true

        System.out.println("12 inch = 1 ft: " +
                new QuantityLength(12.0, LengthUnit.INCH)
                        .equals(new QuantityLength(1.0, LengthUnit.FEET))); // true

        // Different values
        System.out.println("Feet different: " +
                new QuantityLength(1.0, LengthUnit.FEET)
                        .equals(new QuantityLength(2.0, LengthUnit.FEET))); // false

        System.out.println("Inch different: " +
                new QuantityLength(1.0, LengthUnit.INCH)
                        .equals(new QuantityLength(2.0, LengthUnit.INCH))); // false

        // Null comparison
        System.out.println("Null comparison: " +
                new QuantityLength(1.0, LengthUnit.FEET).equals(null)); // false

        // Same reference
        QuantityLength q = new QuantityLength(1.0, LengthUnit.FEET);
        System.out.println("Same reference: " + q.equals(q)); // true

        // Invalid unit (exception test)
        try {
            new QuantityLength(1.0, null);
        } catch (Exception e) {
            System.out.println("Null unit handled: " + e.getMessage());
        }
    }

    // ----------- MAIN -----------
    public static void main(String[] args) {
        runTests();
    }
}